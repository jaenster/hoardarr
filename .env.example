# hoardarr local environment overrides.
#
# Copy this file to `.env` and fill in values for your local setup.
# `.env` is gitignored so creds never enter the repo. Values in `.env`
# take precedence over config.toml; HOARDARR_API_KEY also lets tests
# bypass first-run key generation.

# --- runtime overrides --------------------------------------------------
# HOARDARR_LISTEN=:8085
# HOARDARR_DATA_DIR=./data
# HOARDARR_API_KEY=
# HOARDARR_STORAGE_BACKEND=sqlite
# HOARDARR_SQLITE_PATH=

# --- live-integration test creds ---------------------------------------
# Used by the env-gated integration tests in the M1+ adapter/nntp suite.
# When set, `go test -tags integration ./...` will hit a real provider.
# Leave empty (or comment out) to skip live tests.
#
# HOARDARR_TEST_NNTP_HOST=
# HOARDARR_TEST_NNTP_PORT=563
# HOARDARR_TEST_NNTP_TLS=true
# HOARDARR_TEST_NNTP_USER=
# HOARDARR_TEST_NNTP_PASS=
# HOARDARR_TEST_NNTP_MAX_CONNS=4

# A small public-domain NZB used by the live-integration test. Leave
# empty to use the default test NZB once that fixture is committed.
# HOARDARR_TEST_NZB_PATH=
